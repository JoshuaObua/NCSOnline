FRONTEND_URL=http://localhost:3100
RAILS_ENV=production
NODE_ENV=production
SECRET_KEY_BASE=replace_with_a_long_random_secret
POSTGRES_HOST=ncsbot-postgres
POSTGRES_DATABASE=ncsbot
POSTGRES_USERNAME=ncsbot
POSTGRES_PASSWORD=replace_with_a_strong_database_password
REDIS_URL=redis://:replace_with_a_strong_redis_password@ncsbot-redis:6379
REDIS_PASSWORD=replace_with_a_strong_redis_password
ENABLE_ACCOUNT_SIGNUP=false
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
MAILER_SENDER_EMAIL="NCSBot <ncsbot@example.com>"
SMTP_ADDRESS=
