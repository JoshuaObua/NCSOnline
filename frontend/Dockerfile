FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL=""
ARG VITE_INTRANET_URL=""
ARG VITE_API_PORT="9080"
ARG VITE_INTRANET_PORT="9081"
ARG VITE_PORTAL_API_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_INTRANET_URL=$VITE_INTRANET_URL
ENV VITE_API_PORT=$VITE_API_PORT
ENV VITE_INTRANET_PORT=$VITE_INTRANET_PORT
ENV VITE_PORTAL_API_URL=$VITE_PORTAL_API_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
