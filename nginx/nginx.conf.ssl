user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" rt=$request_time';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    client_max_body_size 20M;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript;

    limit_req_zone $binary_remote_addr zone=website_cms_limit:10m rate=120r/m;
    limit_req_zone $binary_remote_addr zone=website_admin_limit:10m rate=300r/m;

    # HTTP server — serves ACME challenges and redirects everything else to HTTPS
    server {
        listen 80;
        server_name ncsweb.atenimedia.com;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # HTTPS server
    server {
        listen 443 ssl;
        http2 on;
        server_name ncsweb.atenimedia.com;

        ssl_certificate /etc/letsencrypt/live/ncsweb.atenimedia.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/ncsweb.atenimedia.com/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;

        # HSTS
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend "http://backend:8080";
        set $frontend "http://frontend:80";

        location = /health {
            proxy_pass $backend;
            include /etc/nginx/conf.d/proxy_params.conf;
            access_log off;
        }

        location = /healthz {
            proxy_pass $backend;
            include /etc/nginx/conf.d/proxy_params.conf;
            access_log off;
        }

        location /uploads/ {
            alias /app/uploads/;
            expires 30d;
            add_header Cache-Control "public, immutable";
            access_log off;
        }

        location = /api/v1/system/maintenance-status {
            proxy_pass $backend$request_uri;
            include /etc/nginx/conf.d/proxy_params.conf;
        }

        location /api/v1/cms/ {
            limit_req zone=website_cms_limit burst=40 nodelay;
            proxy_pass $backend$request_uri;
            include /etc/nginx/conf.d/proxy_params.conf;
        }

        location /api/v1/auth/ {
            limit_req zone=website_cms_limit burst=20 nodelay;
            proxy_pass $backend$request_uri;
            include /etc/nginx/conf.d/proxy_params.conf;
        }

        location /api/v1/admin/cms/ {
            limit_req zone=website_admin_limit burst=40 nodelay;
            proxy_pass $backend$request_uri;
            include /etc/nginx/conf.d/proxy_params.conf;
        }

        location /api/v1/admin/media/upload {
            limit_req zone=website_admin_limit burst=20 nodelay;
            proxy_pass $backend$request_uri;
            include /etc/nginx/conf.d/proxy_params.conf;
        }

        location /api/v1/admin/ {
            limit_req zone=website_admin_limit burst=40 nodelay;
            proxy_pass $backend$request_uri;
            include /etc/nginx/conf.d/proxy_params.conf;
        }

        location /api/v1/media/upload {
            limit_req zone=website_admin_limit burst=20 nodelay;
            proxy_pass $backend$request_uri;
            include /etc/nginx/conf.d/proxy_params.conf;
        }

        location ~ ^/api/v1/(applications|nsmis|users|roles|transactions|organisations)(\\/)$ {
            return 404;
        }

        location /api/ {
            limit_req zone=website_admin_limit burst=40 nodelay;
            proxy_pass $backend$request_uri;
            include /etc/nginx/conf.d/proxy_params.conf;
        }

        location / {
            proxy_pass $frontend;
            include /etc/nginx/conf.d/proxy_params.conf;
        }
    }
}
